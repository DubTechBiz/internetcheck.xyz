{
  "name": "internetcheck",
  "account_id": "b53a94dbb915dc3f10629470c2cf2fed",

  // Required for Wrangler v3+: locks in behavior versioning
  "compatibility_date": "2026-09-16",

  // Use your own domain — not *.workers.dev
  "workers_dev": false,

  // Serve static files from the root directory
  "assets": {
    "directory": "www",
    "not_found_handling": "404-page"
  },

  "env": {
    "prod": {
      // Apply this Worker to multiple HTTP domains and subdomains
      "routes": [
        {"pattern": "*internetcheck.xyz/*", "zone_id": "8595afd68f782f47576db106ed4c1e13"},
        {"pattern": "*internettest.xyz/*", "zone_id": "63bd3306958632e59bd6e5b9a0ed4acc"},
        {"pattern": "*networkcheck.xyz/*", "zone_id": "c7464304d3d709d4e73d1d7d946760c1"},
        {"pattern": "*networktest.xyz/*", "zone_id": "d93b64522ca5c2bf0f6d358e219cd4d0"},
        {"pattern": "*http.rocks/*", "zone_id": "7dcb81e182ac463d380a9ce07d167ba0"},
      ]
    },
    "dev": {
      // Apply this Worker to multiple HTTP domains and subdomains
      "routes": [
        {"pattern": "*networkstest.xyz/*", "zone_id": "1bf9caa824b74a55e36da9ca46ab8eb9"}
      ]
    }
  }
}
